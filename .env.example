# Go backend API URL (server-side only — the Next.js server fetches all
# documents, images and comments from here)
MDHUB_API_URL=http://localhost:10002

# Public base URL (default: http://localhost:10001/mdhub)
# MDHUB_PUBLIC_BASE_URL=http://localhost:10001/mdhub

# Go search backend API URL (for client-side search)
# The Next.js app's SearchBar calls this directly from the browser.
# NEXT_PUBLIC_SEARCH_API=http://localhost:10002
