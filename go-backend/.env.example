# PostgreSQL connection string (single store: documents, images, comments)
MDHUB_PG="postgres://mdhub:mdhub@localhost:5432/mdhub?sslmode=disable"

# Listen on loopback by default. Bind a public address only behind an
# authenticated reverse proxy.
MDHUB_LISTEN="127.0.0.1:10002"

# Required for all document/image/maintenance writes when configured, and
# mandatory whenever MDHUB_LISTEN is not a loopback address. Use the same long
# random value as the frontend's MDHUB_EDIT_TOKEN.
# MDHUB_EDIT_TOKEN="replace-with-a-random-secret"

# Note: vault files are imported once via CLI flag, not env (pass the vault ROOT):
#   ./mdhub-go -import "/path/to/Obsidian Vault"

# LLM semantic categorization (OpenAI-compatible chat API).
# Leave MDHUB_LLM_API_KEY empty to disable; frontmatter `category: a/b` overrides manually.
# MDHUB_LLM_BASE_URL="https://api.openai.com/v1"
# MDHUB_LLM_API_KEY=""
# MDHUB_LLM_MODEL="gpt-4o-mini"

# Local embedding semantic search (Ollama, CPU). Empty MDHUB_EMBED_URL = disabled.
# MDHUB_EMBED_URL="http://localhost:11434"
# MDHUB_EMBED_MODEL="qwen3-embedding:0.6b"
